name: Обновление расписания
on:
  schedule:
    - cron: "15 */2 * * *"   # каждые 2 часа
  workflow_dispatch:          # и кнопка «Run workflow» вручную
permissions:
  contents: write
jobs:
  update:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: "3.12"
      - run: pip install xlrd openpyxl tzdata
      - run: python scripts/build_schedule.py
      - name: Сохранить изменения
        run: |
          git config user.name "schedule-bot"
          git config user.email "schedule-bot@users.noreply.github.com"
          git add public/schedule.json
          git diff --cached --quiet || (git commit -m "Обновление расписания" && git push)
