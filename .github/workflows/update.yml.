name: Update Schedule

on:
  schedule:
    - cron: '0 */2 * * *' # Каждые 2 часа
  workflow_dispatch: # Позволяет запускать вручную

jobs:
  update:
    runs-on: ubuntu-latest
    permissions:
      contents: write # ВАЖНО: дает право делать git push

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.10'

      - name: Install dependencies
        run: |
          python -m pip install --upgrade pip
          pip install requests xlrd openpyxl tzdata

      - name: Run script
        run: python scripts/build_schedule.py

      - name: Commit and push changes
        run: |
          git config --local user.email "action@github.com"
          git config --local user.name "GitHub Action"
          git add public/schedule.json
          # Проверяем, есть ли изменения, чтобы не было ошибки при пустом коммите
          git diff --quiet && git diff --staged --quiet || (git commit -m "Auto-update schedule" && git push)
